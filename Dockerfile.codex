FROM node:22-bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG CODEX_VERSION=0.144.6

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    jq \
    less \
    procps \
    python3 \
    python3-venv \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Python project manager used by the existing research container.
RUN curl -LsSf https://astral.sh/uv/install.sh \
    | env UV_INSTALL_DIR=/usr/local/bin sh

# Pin Codex so autonomous runs are reproducible. Override CODEX_VERSION at build time to update.
RUN npm install -g "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force

# The official Node image already contains a uid/gid 1000 user. Replace it with a
# project-neutral account whose uid/gid match the invoking Linux user.
RUN userdel -r node 2>/dev/null || true \
    && groupdel node 2>/dev/null || true \
    && groupadd --gid "${GROUP_ID}" agent \
    && useradd --uid "${USER_ID}" --gid "${GROUP_ID}" \
       --create-home --shell /bin/bash agent \
    && mkdir -p /home/agent/.codex /home/agent/.cache /workspace \
    && chown -R "${USER_ID}:${GROUP_ID}" /home/agent /workspace

ENV HOME=/home/agent \
    CODEX_HOME=/home/agent/.codex \
    XDG_CACHE_HOME=/home/agent/.cache \
    UV_CACHE_DIR=/home/agent/.cache/uv \
    UV_LINK_MODE=copy \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /workspace
USER agent

CMD ["codex", "--help"]
